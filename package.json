{
  "name": "story-post",
  "version": "0.0.0",
  "private": true,
  "description": "Offline mobile story game foundation",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "design:render": "pnpm dlx @mermaid-js/mermaid-cli@11.17.0 -i docs/erd.mmd -o docs/erd.svg -b white",
    "design:render:content": "pnpm dlx @mermaid-js/mermaid-cli@11.17.0 -i docs/content-model.mmd -o docs/content-model.svg -b white",
    "design:check": "python3 -m unittest discover -s tests/design -v",
    "start": "expo start",
    "ios": "node scripts/run-mobile.mjs ios",
    "android": "node scripts/run-mobile.mjs android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:check": "tsx scripts/build-content.ts --check",
    "db:check": "tsx scripts/build-migrations.ts --check",
    "db:build": "tsx scripts/build-migrations.ts",
    "build": "pnpm content:check && pnpm db:check && expo export --platform ios --platform android && pnpm bundle:check",
    "bundle:check": "node scripts/check-production-bundle.mjs",
    "check": "pnpm content:check && pnpm authoring:check && pnpm ai:prompt:check && pnpm db:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:ui && pnpm design:check",
    "sdk:check": "pnpm peers check && pnpm exec expo install --check && pnpm dlx expo-doctor@1.20.4",
    "verify": "pnpm check && pnpm build && pnpm sdk:check",
    "content:inspect": "pnpm content:check && tsx scripts/inspect-content.ts",
    "authoring:check": "tsx scripts/check-authoring.ts && tsx scripts/check-authoring-roundtrip.ts && tsx scripts/check-authoring-work.ts && tsx scripts/build-authoring-work.ts --check",
    "authoring:build": "tsx scripts/build-authoring-work.ts",
    "authoring:output:check": "tsx scripts/build-authoring-work.ts --check",
    "authoring:import": "tsx scripts/import-authoring.ts",
    "authoring:export": "tsx scripts/export-authoring.ts",
    "authoring:export:presentation": "tsx scripts/export-authoring-presentation.ts",
    "authoring:csv:export": "tsx scripts/export-authoring-csv.ts",
    "authoring:csv:import": "tsx scripts/import-authoring-csv.ts",
    "authoring:inspect": "tsx scripts/inspect-authoring.ts",
    "authoring:studio": "tsx scripts/authoring-studio.ts",
    "ai:prompt:check": "tsx scripts/check-ai-prompts.ts",
    "test:ui": "jest --runInBand",
    "android:smoke": "node scripts/run-mobile.mjs android --storage-check --localhost",
    "ios:smoke": "node scripts/run-mobile.mjs ios --storage-check --localhost"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "test-renderer": "^1.2.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "openai": "^6.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  }
}
