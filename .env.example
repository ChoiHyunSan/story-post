# Local authoring studio only. Never expose this key through EXPO_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-6-astra
# Image API model. Drafts use low quality and final candidates use high quality.
OPENAI_IMAGE_MODEL=gpt-image-2
# Omit to auto-select OpenAI when a key exists. Use mock only for local UI/tests.
STORY_AI_PROVIDER=
STORY_IMAGE_PROVIDER=
