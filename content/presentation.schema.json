{
  "$id": "https://story-post.local/schemas/presentation-v1.json",
  "title": "Story Post presentation package v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "presentationSchemaVersion": {
      "type": "number",
      "const": 1
    },
    "assets": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "background",
              "portrait",
              "overlay",
              "bgm",
              "sfx",
              "voice"
            ]
          },
          "bundlePath": {
            "type": "string",
            "pattern": "^assets\\/[a-z0-9][a-z0-9/_-]*\\.(?:jpe?g|png|webp|mp3|m4a|wav)$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "altText": {
            "type": "string",
            "maxLength": 500
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "type",
          "bundlePath",
          "hash",
          "altText"
        ],
        "additionalProperties": false
      }
    },
    "cues": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "sceneId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "blockId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "choiceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "scene_enter",
              "before_block",
              "after_block",
              "choices_visible",
              "choice_selected",
              "scene_exit"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "background",
              "portrait",
              "overlay",
              "bgm",
              "sfx",
              "voice"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "show",
              "hide",
              "swap",
              "play",
              "stop",
              "fade_in",
              "fade_out",
              "crossfade"
            ]
          },
          "assetId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fadeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "loop": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "sceneId",
          "trigger",
          "channel",
          "action",
          "ordinal",
          "fadeMs",
          "loop"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "presentationSchemaVersion",
    "assets",
    "cues"
  ],
  "additionalProperties": false
}
